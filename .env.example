# Modèle de configuration : copier ce fichier en .env et renseigner les valeurs.
# Le fichier .env ne doit jamais être versionné.

# Serveur PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=epicevents

# Compte applicatif : lecture/écriture des données, utilisé par le CRM
DB_APP_USER=epicevents_app
DB_APP_PASSWORD=

# Compte propriétaire : création des tables uniquement (script d'initialisation)
DB_OWNER_USER=epicevents_owner
DB_OWNER_PASSWORD=

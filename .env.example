# Modèle de configuration : copier ce fichier en .env et renseigner les valeurs.
# Le fichier .env ne doit jamais être versionné.

# Serveur PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=epicevents

# Super-utilisateur PostgreSQL existant (ex. : postgres, ou votre nom d'utilisateur
# macOS avec Homebrew). Utilisé uniquement par init_db.py pour créer les comptes
# et la base ; laisser le mot de passe vide si le serveur n'en demande pas.
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=

# Compte applicatif : lecture/écriture des données, utilisé par le CRM
# (créé par init_db.py avec ce mot de passe)
DB_APP_USER=epicevents_app
DB_APP_PASSWORD=

# Compte propriétaire : création des tables uniquement
# (créé par init_db.py avec ce mot de passe)
DB_OWNER_USER=epicevents_owner
DB_OWNER_PASSWORD=
